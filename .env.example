# Required for next-auth (Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET=your-secret-here

# Google OAuth (https://console.developers.google.com/)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Microsoft Entra ID / Azure AD (https://portal.azure.com/)
AUTH_MICROSOFT_ID=your-microsoft-client-id
AUTH_MICROSOFT_SECRET=your-microsoft-client-secret
# Optional: override the issuer URL (defaults to common tenant)
# AUTH_MICROSOFT_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Next.js public flag to show env-var warning on /signin in dev
# Set to "true" once OAuth is fully configured
NEXT_PUBLIC_AUTH_CONFIGURED=false
