# ─────────────────────────────────────────────
# ILF Ebook App — Environment Variables Example
# ─────────────────────────────────────────────
# Duplicate this file as .env.local and fill in real values.
# This file IS safe to commit — it contains no real secrets.

# ── Session / Auth ────────────────────────────
# Secret used to sign & verify JWT session tokens (HMAC-SHA256).
# Generate with: openssl rand -base64 32
ILF_SESSION_SECRET=

# Legacy / fallback secret used by signSession() / verifySession() in lib/session.ts.
SESSION_SECRET=
