+  display_name: string;
+  password_hash: string;
+  created_at: number;
+};
+
+export async function getReaderByEmail(email: string): Promise<ReaderRow | null> {
+  const db = await getDB();
+  const row = await db
+    .prepare("SELECT * FROM readers WHERE email = ?1")
+    .bind(email)
+    .first<ReaderRow>();
+  return row ?? null;
+}
