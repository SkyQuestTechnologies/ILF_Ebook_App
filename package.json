{
	"name": "ifl-ebook-app",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": ">=20 <21"
	},
	"scripts": {
			"dev": "next dev",
			"dev:safe": "bash scripts/dev-safe.sh",
			"build": "next build",
			"build:cf": "opennextjs-cloudflare build",
			"deploy": "npm run build:cf && opennextjs-cloudflare deploy",
			"whoami:cf": "CI=1 wrangler whoami",
			"start": "next start",
			"lint": "next lint",
			"upload": "opennextjs-cloudflare upload",
			"preview": "opennextjs-cloudflare preview",
			"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts"
		},
	"dependencies": {
		"@opennextjs/cloudflare": "^1.17.1",
		"next": "16.1.7",
		"react": "19.1.5",
		"react-dom": "19.1.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.35",
		"@types/react": "^19.1.5",
		"@types/react-dom": "^19.1.5",
		"eslint": "^9",
		"eslint-config-next": "15.4.6",
		"tailwindcss": "^4",
		"typescript": "^5.7.4",
		"wrangler": "^4.69.0"
	}
}